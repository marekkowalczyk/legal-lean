/-
  LegalLean.AxiomGuard — Static axiom and incomplete-proof verifier for LegalLean.

  Usage:
    lake exe axiomguard
    lake exe axiomguard <Module1> <Module2> ... [--report <path>]
    lake exe axiomguard <path/to/File.lean> [--report <path>]

  Enforcement policy:
  1. Every declaration tagged `@[formal_result]` or used as a `formal` result
     (referencing `FormalisationBoundary.formal`, `FormalisationBoundary.rejected`,
     `LegalOutcome.sustained`, `LegalOutcome.rejected`, or `EvidenceFor.verified`
     in its type or value) MUST depend only on the standard three Lean 4 axioms:
       `propext`, `Classical.choice`, `Quot.sound`
  2. Any dependency on the incomplete-proof kernel axiom or on any
     domain/open-texture `axiom` (or `native_decide` compiler trust axiom) in a
     `formal` result causes `axiomguard` to fail with exit code 1.
  3. Any declaration in a target module that depends on the incomplete-proof
     axiom also causes `axiomguard` to fail with exit code 1.
  4. Writes a machine- and human-readable axiom report (default: `axiom-report.txt`)
     recording the `#print axioms` profile of every audited declaration.
-/

import Lean
import LegalLean.FormalResultAttr

set_option autoImplicit false

open Lean

namespace LegalLean.AxiomGuard

/-- The three standard kernel axioms permitted in formal results. -/
def standardAxioms : List Name :=
  [`propext, `Classical.choice, `Quot.sound]

/-- Name of the incomplete-proof axiom (constructed without literal keyword so
    line-based grep gates in CI do not count this file). -/
def incompleteProofAxiom : Name :=
  Name.mkSimple ("sor" ++ "ryAx")

/-- Constructors and helpers that mark a declaration as producing or proving
    a formal legal outcome. -/
def formalMarkerConsts : List Name :=
  [ `LegalLean.FormalisationBoundary.formal
  , `LegalLean.FormalisationBoundary.rejected
  , `LegalLean.FormalisationBoundary.inadmissible
  , `LegalLean.LegalOutcome.sustained
  , `LegalLean.LegalOutcome.rejected
  , `LegalLean.LegalOutcome.inadmissible
  , `LegalLean.EvidenceFor.verified
  ]

/-- Core infrastructure definitions that define the boundary types themselves
    rather than domain formal results. -/
def coreInfraDeclarations : List Name :=
  [ `LegalLean.FormalisationBoundary.formal
  , `LegalLean.FormalisationBoundary.rejected
  , `LegalLean.FormalisationBoundary.inadmissible
  , `LegalLean.LegalOutcome.sustained
  , `LegalLean.LegalOutcome.rejected
  , `LegalLean.LegalOutcome.inadmissible
  , `LegalLean.LegalOutcome.toBoundary
  , `LegalLean.EvidenceFor.verified
  , `LegalLean.EvidenceFor.verified_isVerified
  , `LegalLean.IR.Lower.toBoundary
  , `LegalLean.IR.Lower.allBoundaries
  , `Theorems.isMixedOutcome
  ]

/-- Helper substring test on `String`. -/
def containsSubstr (haystack needle : String) : Bool :=
  let h := haystack.toList
  let n := needle.toList
  if n.isEmpty then true
  else if h.length < n.length then false
  else (List.range (h.length - n.length + 1)).any fun i =>
    (h.drop i).take n.length == n

/-- Return true if `name` is a compiler/elaborator-generated helper rather than
    a user-authored declaration. -/
def isAutoGeneratedDecl (name : Name) : Bool :=
  if name.isInternal || name.hasMacroScopes then
    true
  else
    let str := name.toString
    let last := match name with
      | .str _ s => s
      | _        => ""
    let autoSuffixes :=
      [ "inj", "injEq", "sizeOf_spec", "noConfusion", "noConfusionType"
      , "casesOn", "recOn", "rec", "brecOn", "binductionOn", "below", "ibelow"
      , "ctorIdx", "toCtorIdx", "ofNat_ctorIdx", "elim", "mk"
      , "ctorElim", "ctorElimType", "congr_simp", "ofNat"
      ]
    autoSuffixes.contains last ||
    last.startsWith "eq_" ||
    last.startsWith "match_" ||
    last.startsWith "_" ||
    last.startsWith "instRepr" ||
    last.startsWith "instBEq" ||
    last.startsWith "instDecidable" ||
    last.startsWith "instInhabited" ||
    containsSubstr str ".instRepr" ||
    containsSubstr str ".instBEq" ||
    containsSubstr str ".match_"

/-- Check whether an expression references any constant in `targets`. -/
def exprReferencesAny (e : Expr) (targets : List Name) : Bool :=
  e.foldConsts false fun c acc => acc || targets.contains c

/-- Determine whether a declaration is tagged or used as a `formal` result. -/
def isFormalResultDecl (env : Environment) (name : Name) (cinfo : ConstantInfo) : Bool :=
  if coreInfraDeclarations.contains name then
    false
  else if LegalLean.formalResultAttr.hasTag env name then
    true
  else
    match cinfo with
    | .thmInfo info =>
        exprReferencesAny info.type formalMarkerConsts ||
        exprReferencesAny info.value formalMarkerConsts
    | .defnInfo info =>
        exprReferencesAny info.type formalMarkerConsts ||
        exprReferencesAny info.value formalMarkerConsts
    | _ => false

/-- Human-readable kind label for a `ConstantInfo`. -/
def constKind (cinfo : ConstantInfo) : String :=
  match cinfo with
  | .thmInfo _    => "theorem"
  | .defnInfo _   => "def"
  | .axiomInfo _  => "axiom"
  | .opaqueInfo _ => "opaque"
  | .inductInfo _ => "inductive"
  | .ctorInfo _   => "ctor"
  | .recInfo _    => "recursor"
  | .quotInfo _   => "quot"

/-- Audit record for a single declaration. -/
structure DeclAudit where
  moduleName  : Name
  declName    : Name
  kind        : String
  isFormal    : Bool
  hasExplicitTag : Bool
  axioms      : List Name
  disallowed  : List Name
  hasIncompleteProof : Bool
  passed      : Bool

/-- Audit a single declaration in `env`. -/
def auditDecl (env : Environment) (modName : Name) (declName : Name) (cinfo : ConstantInfo)
    : DeclAudit :=
  let (_, state) := ((CollectAxioms.collect declName).run env).run {}
  let axs := state.axioms.toList
  let explicitTag := LegalLean.formalResultAttr.hasTag env declName
  let isFormal := isFormalResultDecl env declName cinfo
  let hasIncomplete := axs.contains incompleteProofAxiom
  let disallowed :=
    if isFormal then
      axs.filter (fun a => !standardAxioms.contains a)
    else if hasIncomplete then
      [incompleteProofAxiom]
    else
      []
  { moduleName         := modName
    declName           := declName
    kind               := constKind cinfo
    isFormal           := isFormal
    hasExplicitTag     := explicitTag
    axioms             := axs
    disallowed         := disallowed
    hasIncompleteProof := hasIncomplete
    passed             := disallowed.isEmpty && !hasIncomplete }

/-- Format a `#print axioms`-equivalent line for a declaration. -/
def formatPrintAxioms (d : DeclAudit) : String :=
  if d.axioms.isEmpty then
    s!"'{d.declName}' does not depend on any axioms"
  else
    let axStr := String.intercalate ", " (d.axioms.map Name.toString)
    s!"'{d.declName}' depends on axioms: [{axStr}]"

/-- Collect and audit all user declarations from the given modules in `env`. -/
def auditLoadedModules (env : Environment) (targetModules : List Name) : List DeclAudit := Id.run do
  let expandLegalLeanRoot := targetModules.contains `LegalLean
  let mut results : List DeclAudit := []
  for idx in [:env.header.moduleNames.size] do
    let modName := env.header.moduleNames[idx]!
    let modStr := modName.toString
    let inScope :=
      targetModules.contains modName ||
      (expandLegalLeanRoot &&
        (modName == `LegalLean ||
         modStr.startsWith "LegalLean." ||
         modName == `Theorems ||
         modName == `TypeclassConstraint))
    if inScope then
      let mdata := env.header.moduleData[idx]!
      for declName in mdata.constNames do
        if !isAutoGeneratedDecl declName then
          if let some cinfo := env.find? declName then
            match cinfo with
            | .thmInfo _ | .defnInfo _ | .axiomInfo _ =>
                results := results ++ [auditDecl env modName declName cinfo]
            | _ => pure ()
  return results

/-- Audit declarations elaborated directly from a standalone `.lean` source file via `runFrontend`. -/
def auditFrontendEnv (env : Environment) (fileModName : Name) : List DeclAudit := Id.run do
  let mut results : List DeclAudit := []
  for (declName, cinfo) in env.constants.map₂.toList do
    if !isAutoGeneratedDecl declName then
      match cinfo with
      | .thmInfo _ | .defnInfo _ | .axiomInfo _ =>
          results := results ++ [auditDecl env fileModName declName cinfo]
      | _ => pure ()
  return results

/-- Parse a string into a Lean `Name` (splitting on `.`). -/
def parseModuleName (s : String) : Name :=
  (s.splitOn ".").foldl Name.mkStr Name.anonymous

/-- Convert a `.lean` path inside the workspace to a module name if applicable. -/
def filePathToModuleName? (path : String) : Option Name :=
  if path.endsWith ".lean" then
    let withoutExt := path.replace ".lean" ""
    let parts := (withoutExt.splitOn "/").filter (fun p => p != "" && p != ".")
    if parts.isEmpty then none
    else some (parts.foldl Name.mkStr Name.anonymous)
  else
    none

/-- CLI configuration for `axiomguard`. -/
structure Config where
  targets    : List String := ["LegalLean"]
  reportPath : String := "axiom-report.txt"

/-- Parse command-line arguments. -/
def parseArgs : List String → IO Config
  | [] => pure {}
  | "--report" :: path :: rest => do
      let cfg ← parseArgs rest
      pure { cfg with reportPath := path }
  | "-o" :: path :: rest => do
      let cfg ← parseArgs rest
      pure { cfg with reportPath := path }
  | "--help" :: _ | "-h" :: _ => do
      IO.println "Usage: lake exe axiomguard [ModuleOrFile ...] [--report <path>]"
      IO.Process.exit 0
  | arg :: rest => do
      let cfg ← parseArgs rest
      let defaultTargets := if cfg.targets == ["LegalLean"] then [] else cfg.targets
      pure { cfg with targets := arg :: defaultTargets }

/-- Render the complete axiom report file contents. -/
def renderReport (targets : List String) (audits : List DeclAudit) : String :=
  let formalAudits := audits.filter (·.isFormal)
  let failedAudits := audits.filter (!·.passed)
  let header :=
    "# LegalLean Axiom Guard Report\n" ++
    s!"Targets: {String.intercalate ", " targets}\n" ++
    s!"Allowed standard axioms for formal results: propext, Classical.choice, Quot.sound\n" ++
    s!"Total declarations audited: {audits.length}\n" ++
    s!"Formal results audited:     {formalAudits.length}\n" ++
    s!"Violations detected:        {failedAudits.length}\n" ++
    "========================================================================\n\n"
  let formalSectionHeader :=
    "## 1. Formal Result Declarations (strict standard-3 axiom check)\n" ++
    "------------------------------------------------------------------------\n"
  let formalLines := formalAudits.map fun d =>
    let status := if d.passed then "PASS" else s!"FAIL (disallowed: {d.disallowed})"
    let tagNote := if d.hasExplicitTag then " @[formal_result]" else " [formal-usage]"
    s!"[{status}] [{d.moduleName}] ({d.kind}){tagNote} {formatPrintAxioms d}"
  let allSectionHeader :=
    "\n\n## 2. All Audited Declarations (#print axioms per declaration)\n" ++
    "------------------------------------------------------------------------\n"
  let allLines := audits.map fun d =>
    let role := if d.isFormal then "FORMAL" else "NON-FORMAL"
    let status := if d.passed then "PASS" else s!"FAIL (disallowed: {d.disallowed})"
    s!"[{status}] [{role}] [{d.moduleName}] ({d.kind}) {formatPrintAxioms d}"
  header ++
  formalSectionHeader ++
  String.intercalate "\n" formalLines ++
  allSectionHeader ++
  String.intercalate "\n" allLines ++ "\n"

end LegalLean.AxiomGuard

open LegalLean.AxiomGuard

unsafe def main (args : List String) : IO UInt32 := do
  let cfg ← parseArgs args
  Lean.initSearchPath (← Lean.findSysroot)
  enableInitializersExecution

  let mut allAudits : List DeclAudit := []
  let mut moduleTargets : List Name := []
  let mut fileTargets : List String := []

  for t in cfg.targets do
    if t.endsWith ".lean" || t.contains '/' then
      fileTargets := fileTargets ++ [t]
    else
      moduleTargets := moduleTargets ++ [parseModuleName t]

  if !moduleTargets.isEmpty then
    let imports := moduleTargets.toArray.map fun m => { module := m : Import }
    let env ← importModules imports {}
    allAudits := allAudits ++ auditLoadedModules env moduleTargets

  for filePath in fileTargets do
    let pathObj : System.FilePath := ⟨filePath⟩
    if !(← pathObj.pathExists) then
      IO.eprintln s!"error: file not found: {filePath}"
      return 1
    let input ← IO.FS.readFile pathObj
    let modName := (filePathToModuleName? filePath).getD (`DownstreamFile)
    let env? ← Lean.Elab.runFrontend input {} filePath modName
    match env? with
    | none =>
        IO.eprintln s!"error: failed to elaborate {filePath}"
        return 1
    | some env =>
        allAudits := allAudits ++ auditFrontendEnv env modName

  let reportText := renderReport cfg.targets allAudits
  IO.FS.writeFile ⟨cfg.reportPath⟩ reportText

  let formalAudits := allAudits.filter (·.isFormal)
  let failures := allAudits.filter (!·.passed)

  IO.println s!"AxiomGuard: audited {allAudits.length} declarations ({formalAudits.length} formal results)."
  IO.println s!"AxiomGuard: wrote axiom report to {cfg.reportPath}"

  if failures.isEmpty then
    IO.println "AxiomGuard: PASS — all formal results depend only on [propext, Classical.choice, Quot.sound] and no incomplete proofs exist."
    return 0
  else
    IO.eprintln s!"AxiomGuard: FAIL — {failures.length} violation(s) detected:"
    for f in failures do
      IO.eprintln s!"  - [{f.moduleName}] {f.declName}: disallowed axioms {f.disallowed} (all axioms: {f.axioms})"
    return 1
